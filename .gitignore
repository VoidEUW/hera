# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Databases / local state
*.db
*.db-wal
*.db-shm
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Web. The paths are ADR 9's: one application package at apps/core, with the interface under
# web/ building into the directory the API serves.
node_modules/
apps/core/web/.svelte-kit/
apps/core/web/openapi.json
# Build output, not source. The wheel ships it, so `npm run build` comes before `uv build`.
apps/core/src/hera_core/static/*
!apps/core/src/hera_core/static/.gitkeep
test-results/
playwright-report/
blob-report/

# OS / editors
.DS_Store
*.swp
