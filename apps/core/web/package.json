{
	"name": "hera-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"postbuild": "node -e \"require('fs').closeSync(require('fs').openSync('../src/hera_core/static/.gitkeep','a'))\"",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run",
		"generate": "python ../../../scripts/openapi.py && openapi-typescript openapi.json -o src/lib/api/schema.d.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.17.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"eslint": "^9.20.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.14.0",
		"jsdom": "^30.0.1",
		"openapi-typescript": "^7.6.1",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"svelte": "^5.57.0",
		"svelte-check": "^4.1.4",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.22.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@fontsource-variable/figtree": "^5.1.1",
		"@fontsource-variable/fraunces": "^5.1.1",
		"@fontsource-variable/source-serif-4": "^5.1.1",
		"@fontsource/ibm-plex-mono": "^5.1.1",
		"dompurify": "^3.4.14",
		"katex": "^0.18.4",
		"marked": "^18.0.11",
		"marked-katex-extension": "^5.1.12"
	}
}
