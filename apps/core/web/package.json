{
	"name": "hera-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"postbuild": "node -e \"require('fs').closeSync(require('fs').openSync('../src/hera_core/static/.gitkeep','a'))\"",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run",
		"generate": "python ../../../scripts/openapi.py && openapi-typescript openapi.json -o src/lib/api/schema.d.ts",
		"theme:import": "node scripts/import-theme.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"jsdom": "^30.1.3",
		"openapi-typescript": "^7.6.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@fontsource-variable/albert-sans": "^5.3.0",
		"@fontsource-variable/cormorant-garamond": "^5.3.0",
		"@fontsource-variable/fira-code": "^5.3.0",
		"@fontsource-variable/newsreader": "^5.3.0",
		"dompurify": "^3.4.17",
		"highlight.js": "^11.12.0",
		"katex": "^0.19.1",
		"marked": "^18.1.1",
		"marked-katex-extension": "^5.1.13",
		"mermaid": "^12.2.0"
	},
	"overrides": {
		"openapi-typescript": {
			"typescript": "$typescript"
		}
	}
}
